<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/loc: lists every text the player reads for translators (extract), and wrapped them in Loc.T in the first
       place (survey, wrap). Not part of the game: Keywright.csproj leaves tools/ out and .gdignore keeps Godot out. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LocTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
