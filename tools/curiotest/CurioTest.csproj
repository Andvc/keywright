<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/curiotest: checks that every curio does what its card says, against the game's Core rules, headlessly
       (dotnet run, from the repository root with project tools/curiotest). Not part of the game: Keywright.csproj
       leaves tools/ out, and .gdignore keeps Godot out. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CurioTest</RootNamespace>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
