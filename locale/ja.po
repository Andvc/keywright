msgstr "魔力"

#: scripts/Core/Curios.cs:466
msgid "sight unseen"
msgstr "触れず買い"

#: scripts/Core/Curios.cs:467
msgid "rough hands"
msgstr "荒っぽい手つき"

#: scripts/Core/Curios.cs:468
msgid "fakes"
msgstr "偽物"

#: scripts/Core/Curios.cs:469
