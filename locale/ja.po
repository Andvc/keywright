#: scripts/Core/Random.cs:37
msgid "one coin"
msgstr "硬貨一枚"

#: scripts/Core/Random.cs:37
msgid "{0} gold"
msgstr "{0}ゴールド"

#: scripts/Core/Save.cs:281
msgid "Week {0}, day {1}, {2}, {3}g"
msgstr "{0}週目{1}日目、{2}、{3}G"

