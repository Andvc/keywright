msgid "The Crown Chest"
msgstr "王冠寶箱"

#: scripts/Core/Achievements.cs:27
msgid "Open King Aldric's Crown Chest."
msgstr "開啟奧德里克國王的王冠寶箱。"

#: scripts/Core/Achievements.cs:28
msgid "A Song in the Box"
msgstr "箱中之歌"

#: scripts/Core/Achievements.cs:28
