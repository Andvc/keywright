#: scripts/Core/Curios.cs:102
msgid ""
"Every chest you pass makes the next seller ask {0} less (up to {1}). Buying starts it again."
msgstr ""
"Chaque coffre passé fait baisser de {0} le prix du vendeur suivant (jusqu'à {1}). Un achat remet tout à zéro."

#: scripts/Core/Curios.cs:104
msgid "Closing Bell"
msgstr "Cloche du soir"

#: scripts/Core/Curios.cs:104
msgid "The last customer of the day asks {0} less."
msgstr "Le dernier client de la journée demande {0} de moins."

#: scripts/Core/Curios.cs:105
msgid "Haggler's Purse"
msgstr "Bourse du marchandeur"

#: scripts/Core/Curios.cs:105
msgid ""
"Everyone haggles with you, and {0} of whatever you talk them down by comes back to you as well."
msgstr ""
"Tout le monde marchande avec vous, et {0} de chaque rabais obtenu vous revient en plus."

#: scripts/Core/Curios.cs:107
msgid "Golden Tongue"
msgstr "Langue d'or"

