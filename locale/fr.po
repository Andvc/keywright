msgid "said"
msgstr "dit"

#: scripts/Core/Inquiry.cs:116
msgid "tried"
msgstr "essayé"

#: scripts/Core/Inquiry.cs:117
msgid "heard"
msgstr "entendu"

#: scripts/Core/Inquiry.cs:118
