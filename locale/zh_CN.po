msgstr "{0}金币"

#: scripts/Core/Run.cs:328
msgid "The Crown Chest."
msgstr "王冠宝箱。"

#: scripts/Core/Save.cs:223
msgid "Week {0}, day {1}, {2}, {3}g"
msgstr "第{0}周第{1}天，{2}，{3}金"

#: scripts/Core/Save.cs:433
msgid "Best: week {0}   Debts cleared: {1}{2}   Crown Chests opened: {3}{4}"
msgstr "最远：第{0}周   还清债务：{1}次{2}   打开王冠宝箱：{3}次{4}"

#: scripts/Core/Save.cs:433
