msgstr "买下一只宝箱并打开它。"

#: scripts/Core/Achievements.cs:20 scripts/Core/Shop.cs:15
msgid "Thornwick Market"
msgstr "荆棘镇集市"

#: scripts/Core/Achievements.cs:20
msgid "Move Bram's stall to Thornwick Market."
msgstr "把布拉姆的摊位搬到荆棘镇集市。"

#: scripts/Core/Achievements.cs:21 scripts/Core/Shop.cs:16
msgid "Crownhold"
msgstr "王冠堡"

#: scripts/Core/Achievements.cs:21
msgid "Move the shop to Crownhold."
msgstr "把店铺搬到王冠堡。"

#: scripts/Core/Achievements.cs:22
msgid "By Royal Appointment"
msgstr "皇家御用"

#: scripts/Core/Achievements.cs:22
msgid "Open the Royal Emporium."
msgstr "开设皇家商行。"

#: scripts/Core/Achievements.cs:23
msgid "The Guild's Due"
msgstr "公会的贡金"

#: scripts/Core/Achievements.cs:23
msgid "Pay the Gilded Guild its first tithe."
msgstr "向镀金公会缴纳第一笔贡金。"

#: scripts/Core/Achievements.cs:24
msgid "Paid in Full"
msgstr "全数还清"

#: scripts/Core/Achievements.cs:24
msgid "Clear Bram's debt to the Guild."
msgstr "还清布拉姆欠公会的债务。"

#: scripts/Core/Achievements.cs:25
msgid "Ahead of Time"
msgstr "提前还清"

#: scripts/Core/Achievements.cs:25
msgid "Clear the debt with a week to spare."
msgstr "提前一周还清债务。"

#: scripts/Core/Achievements.cs:27 scripts/Core/Meta.cs:279 scripts/Phases/OpeningPhase.cs:79
msgid "The Crown Chest"
msgstr "王冠宝箱"

#: scripts/Core/Achievements.cs:27
msgid "Open King Aldric's Crown Chest."
msgstr "打开奥德里克国王的王冠宝箱。"

#: scripts/Core/Achievements.cs:28
msgid "A Song in the Box"
msgstr "箱中之歌"

#: scripts/Core/Achievements.cs:28
msgid "Keep a Heartsong."
msgstr "收下一首心歌。"

#: scripts/Core/Achievements.cs:29
msgid "Sung Whole"
msgstr "九歌齐鸣"

#: scripts/Core/Achievements.cs:29
msgid "Hear all nine Heartsongs, across your runs."
msgstr "跨局累计听过全部九首心歌。"

#: scripts/Core/Achievements.cs:30
msgid "It Glows"
msgstr "它在发光"

#: scripts/Core/Achievements.cs:30
msgid "Find an enchanted thing."
msgstr "找到一件附魔物品。"

#: scripts/Core/Achievements.cs:31
msgid "A Perfect Read"
msgstr "完美判断"

#: scripts/Core/Achievements.cs:31
msgid "Tick exactly what's in a chest before you open it."
msgstr "开箱前，一样不差地勾选出宝箱里的东西。"

#: scripts/Core/Achievements.cs:32
msgid "Never Wrong"
msgstr "从不出错"

#: scripts/Core/Achievements.cs:32
msgid "Make five perfect reads in a row."
msgstr "连续做出五次完美判断。"

#: scripts/Core/Achievements.cs:33
msgid "Hollow"
msgstr "暗藏乾坤"

#: scripts/Core/Achievements.cs:33
msgid "Find what's under a false bottom."
msgstr "找到夹层里的东西。"

#: scripts/Core/Achievements.cs:34
msgid "Named"
msgstr "一语道破"

#: scripts/Core/Achievements.cs:34
msgid "Name a warded thing, and see it come out."
msgstr "说出被结界封住的物品，看着它现身。"

#: scripts/Core/Achievements.cs:35
msgid "Collector"
msgstr "收藏家"

#: scripts/Core/Achievements.cs:35
msgid "Find half the things there are, across your runs."
msgstr "跨局累计找到半数物品。"

#: scripts/Core/Achievements.cs:37
msgid "Every Thing in Aldmark"
msgstr "奥德马克万物"

#: scripts/Core/Achievements.cs:37
msgid "Find every thing there is, across your runs."
msgstr "跨局累计找到所有物品。"

#: scripts/Core/Achievements.cs:39 scripts/Core/Meta.cs:23
msgid "The Ear"
msgstr "灵耳"

#: scripts/Core/Achievements.cs:39
msgid "Clear the debt as Kit."
msgstr "以基特的身份还清债务。"

#: scripts/Core/Achievements.cs:40 scripts/Core/Meta.cs:29
msgid "The Scale"
msgstr "公平秤"

#: scripts/Core/Achievements.cs:40
msgid "Clear the debt as Hesk."
msgstr "以赫斯克的身份还清债务。"

#: scripts/Core/Achievements.cs:41 scripts/Core/Meta.cs:36
msgid "The Tongue"
msgstr "巧舌"

#: scripts/Core/Achievements.cs:41
msgid "Clear the debt as Rosa."
msgstr "以罗莎的身份还清债务。"

#: scripts/Core/Achievements.cs:42 scripts/Core/Meta.cs:43
msgid "The Collection"
msgstr "珍藏"

#: scripts/Core/Achievements.cs:42
msgid "Clear the debt as Isolde."
msgstr "以伊索尔德的身份还清债务。"

#: scripts/Core/Achievements.cs:43
msgid "Hard Bargains"
msgstr "艰难买卖"

#: scripts/Core/Achievements.cs:43
msgid "Clear the debt at challenge level 4."
msgstr "在挑战等级4还清债务。"

#: scripts/Core/Achievements.cs:44
msgid "The Wall"
msgstr "高墙"

#: scripts/Core/Achievements.cs:44
msgid "Clear the debt at challenge level 8."
msgstr "在挑战等级8还清债务。"

